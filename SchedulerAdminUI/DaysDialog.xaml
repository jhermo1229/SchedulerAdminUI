<Window x:Class="SchedulerAdminUI.DaysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Days"
        Height="360"
        Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select days this job should run:"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="MondayCheckBox" Content="Monday" Margin="0,4"/>
            <CheckBox x:Name="TuesdayCheckBox" Content="Tuesday" Margin="0,4"/>
            <CheckBox x:Name="WednesdayCheckBox" Content="Wednesday" Margin="0,4"/>
            <CheckBox x:Name="ThursdayCheckBox" Content="Thursday" Margin="0,4"/>
            <CheckBox x:Name="FridayCheckBox" Content="Friday" Margin="0,4"/>
            <CheckBox x:Name="SaturdayCheckBox" Content="Saturday" Margin="0,4"/>
            <CheckBox x:Name="SundayCheckBox" Content="Sunday" Margin="0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="OK"
                    Width="80"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>